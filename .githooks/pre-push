#!/usr/bin/env bash
# Run asset generators before pushing main (GitHub Pages / prod).
# If thumbs or share pages change, abort so they can be committed first.
set -euo pipefail

pushing_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    pushing_main=1
    break
  fi
done

if [[ "$pushing_main" -eq 0 ]]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] prod (main): npm run thumbs && npm run share-pages"
npm run thumbs
npm run share-pages

dirty=0
if ! git diff --quiet -- assets/characters/thumbs share; then
  dirty=1
fi
if ! git diff --cached --quiet -- assets/characters/thumbs share; then
  dirty=1
fi
untracked="$(git ls-files --others --exclude-standard -- assets/characters/thumbs share || true)"
if [[ -n "$untracked" ]]; then
  dirty=1
fi

if [[ "$dirty" -ne 0 ]]; then
  echo ""
  echo "[pre-push] Generated files changed. Commit them, then push again:"
  git status --short -- assets/characters/thumbs share
  exit 1
fi

echo "[pre-push] thumbs + share-pages up to date"
exit 0
