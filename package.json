{
  "name": "story-site",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "sync": "node scripts/sync-stories.mjs && node scripts/generate-story-share-pages.mjs",
    "sync:andrea-complete": "node scripts/sync-andrea-lucas-complete-to-dist.mjs",
    "sync:concurrent": "node scripts/sync-stories.mjs --concurrency=4 && node scripts/generate-story-share-pages.mjs",
    "pdf": "node scripts/render-story-pdf.mjs",
    "pdf:andrea-part-1": "node scripts/render-andrea-complete-chapters-pdf.mjs --part=1",
    "epub": "node scripts/render-story-epub.mjs",
    "anthology": "node scripts/render-anthology-epub.mjs",
    "publish": "node scripts/publish.mjs",
    "share-pages": "node scripts/generate-story-share-pages.mjs",
    "deploy:story-views": "npx wrangler deploy --config workers/story-views/wrangler.toml",
    "reddit-post-sections": "node scripts/reddit-post-sections.mjs",
    "copy-edit-server": "npm --prefix tools/copy-edit-server run start"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0"
  }
}
