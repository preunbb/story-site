{
  // Over Easy catalog — products.js is prose-heavy; keep the editor out of the way.
  "files.associations": {
    "over-easy-products/products.js": "oe-catalog"
  },
  "[oe-catalog]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 88,
    "editor.formatOnSave": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.tabCompletion": "off"
  },
  "github.copilot.enable": {
    "*": true,
    "oe-catalog": false
  },
  "cursor.cpp.disabledLanguages": ["oe-catalog"],
  "emeraldwalk.RunOnSave": {
    "commands": [
      {
        "match": "over-easy-products/products\\.js$",
        "cmd": "node ${workspaceFolder}/tools/over-easy-product/format-catalog.mjs",
        "runIn": "backend",
        "silent": true
      }
    ]
  }
}
