# Copy to `.env.local` (gitignored) for premium-story tooling.

# Andrea & Lucas — editable Drive doc id + Publish-to-web URL (sync:andrea-complete).
ANDREA_LUCAS_EDIT_DOC_ID=
ANDREA_LUCAS_PUBLISH_URL=
# Shared reader password for client-side decrypt (encrypt:andrea-lucas).
# Never commit this value. Only a domain-separated SHA-256 gate hash is stored in git.
ANDREA_LUCAS_READER_PASSWORD=

# Bereavement Counseling — optional overrides (sync:bereavement has fallbacks).
BEREAVEMENT_EDIT_DOC_ID=
BEREAVEMENT_PUBLISH_URL=
# Reader password for client-side decrypt (encrypt:bereavement). Never commit.
BEREAVEMENT_READER_PASSWORD=

# Quality Control chapter 5 / sidebar chapter 6 (encrypt:password-chapters).
# Never commit the password. Only the gate hash in data/stories.js is public.
QUALITY_CONTROL_CH6_PASSWORD=

# Unreleased catalog stories (Self Defense, Mother Knows Best, …).
# Publish URLs live in gitignored dist/drive_doc_ids.json as `publish_url`.
# Optional overrides if you need to point sync at a different published Doc:
# STORY_59_PUBLISH_URL=
# STORY_60_PUBLISH_URL=
